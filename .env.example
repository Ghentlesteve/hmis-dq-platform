# Copy this file to .env and fill in the values. .env is git-ignored.
# Use a public DHIS2 demo instance (see https://im.dhis2.org/public/instances)
# or any DHIS2 server you are allowed to read from.
HMIS_DHIS2_BASE_URL=https://your-dhis2-instance.example.org
HMIS_DHIS2_USERNAME=
HMIS_DHIS2_PASSWORD=
HMIS_DATA_DIR=data
# Where `hmis-dq extract` writes: lake (S3, needs docker compose) or local (data/raw)
HMIS_STORE=lake

# Local data lake (docker compose). Generate the secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
HMIS_S3_ENDPOINT_URL=http://localhost:8333
HMIS_S3_ACCESS_KEY=hmis-local
HMIS_S3_SECRET_KEY=

# Optional: host ports for the lake and dashboard, if Windows has reserved the defaults
# (check with: netsh interface ipv4 show excludedportrange protocol=tcp)
# HMIS_S3_PORT=8333
# HMIS_FILER_PORT=18888
# HMIS_MASTER_PORT=19333
# HMIS_DASHBOARD_PORT=8501
