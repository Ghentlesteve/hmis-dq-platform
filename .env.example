# Copy this file to .env and fill in the values. .env is git-ignored.
# Use a public DHIS2 demo instance (see https://im.dhis2.org/public/instances)
# or any DHIS2 server you are allowed to read from.
HMIS_DHIS2_BASE_URL=https://your-dhis2-instance.example.org
HMIS_DHIS2_USERNAME=
HMIS_DHIS2_PASSWORD=
HMIS_DATA_DIR=data
